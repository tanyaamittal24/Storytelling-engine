# Copy this file to .env and fill in your key.
# Get a free Groq API key at https://console.groq.com/keys
GROQ_API_KEY=

# If GROQ_API_KEY is left empty, the app automatically falls back to
# MOCK MODE — it returns pre-written sample scenes instead of calling
# the LLM. This lets you demo and test the full loop (including the
# database) without needing an API key.
